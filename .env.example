# ============================================================
# GS08 - Matriculas | copiar a .env y ajustar si hace falta
#   cp .env.example .env
# Compose funciona sin .env (usa estos valores por defecto).
# ============================================================

# --- Base de datos ---
POSTGRES_DB=gs08_matriculas
POSTGRES_USER=gs08
POSTGRES_PASSWORD=gs08_dev_pwd
DB_PORT=5432

# --- API ---
API_PORT=8000
ENVIRONMENT=local
LOG_LEVEL=info
SECRET_KEY=cambiar-esta-clave-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Cliente OAuth2 propio (D-29) ---
# El SPA es cliente publico: puede pedir el token sin estas credenciales. Se declaran
# para que las integraciones (curl, Postman) puedan autenticarse como cliente y para
# cambiarlas en produccion.
OAUTH_CLIENT_ID=gs08-spa
OAUTH_CLIENT_SECRET=gs08-spa-secreto-local

# --- Segunda base documental y cache (rubrica: BD hibrida y caching distribuido) ---
# Vacio = la pieza queda apagada y el API responde igual (sin bitacora / sin cache).
MONGO_URL=mongodb://mongo:27017
MONGO_BD=gs08_bitacora
MONGO_PORT=27017
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
CACHE_TTL_SEGUNDOS=60

# --- Frontend ---
WEB_PORT=8080
VITE_API_BASE_URL=/api/v1

# --- Observabilidad ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=gs08_grafana
# Logging centralizado: descomentar y levantar con --profile obs
# LOKI_URL=http://loki:3100
LOKI_PORT=3100

# --- Zona horaria ---
TZ=America/Lima
