# ============================================================
# GS08 - Matriculas | copiar a .env y ajustar si hace falta
#   cp .env.example .env
# Compose funciona sin .env (usa estos valores por defecto).
# ============================================================

# --- Base de datos ---
POSTGRES_DB=gs08_matriculas
POSTGRES_USER=gs08
POSTGRES_PASSWORD=gs08_dev_pwd
DB_PORT=5432

# --- API ---
API_PORT=8000
ENVIRONMENT=local
LOG_LEVEL=info
SECRET_KEY=cambiar-esta-clave-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Frontend ---
WEB_PORT=8080
VITE_API_BASE_URL=/api/v1

# --- Observabilidad ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=gs08_grafana

# --- Zona horaria ---
TZ=America/Lima
